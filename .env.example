# .env.example

# Copy this file to .env and replace the placeholder values with your actual API keys and configuration.
ASSEMBLYAI_API_KEY=your_assemblyai_api_key
OPENAI_API_KEY=your_openai_api_key
XAI_API_KEY=your_xai_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
# Comma-separated models create separate dropdown entries; the first is the default.
# Example: elevenlabs/scribe-v2,microsoft/mai-transcribe-2,mistralai/voxtral-mini-transcribe
OPENROUTER_MODEL_NAME=elevenlabs/scribe-v2
GEMINI_API_KEY=your_gemini_api_key
GEMINI_PROVIDER=google  # 'google' for Gemini API, or 'vertex' for Vertex AI
VERTEXAI_PROJECT_ID=your_gcp_project_id
VERTEXAI_LOCATION=us-central1
GEMINI_MODEL_NAME=gemini-pro-latest,gemini-3.8-flash
# Example: GEMINI_MODEL_NAME=gemini-pro-latest,gemini-4-argon,gemini-3.5-transcribe,gemini-3.8-flash
OPENAI_MAX_CONCURRENCY=4
GEMINI_MAX_CONCURRENCY=4
GROK_MAX_CONCURRENCY=4
OPENROUTER_MAX_CONCURRENCY=4
TZ=Your/Timezone
DEFAULT_TRANSCRIBE_API=gpt4o
DEFAULT_LANGUAGE=auto
